{
  "name": "paperclip-clippy-plugin",
  "version": "0.1.0",
  "description": "Paperclip plugin that replaces host toasts with a Clippy-style assistant overlay.",
  "author": "Alvaro Sanchez-Mariscal",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "homepage": "https://github.com/alvarosanchez/paperclip-clippy-plugin#readme",
  "bugs": {
    "url": "https://github.com/alvarosanchez/paperclip-clippy-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvarosanchez/paperclip-clippy-plugin.git"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "clippy",
    "toast",
    "notification",
    "office-assistant"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "node ./scripts/build.mjs --watch",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm verify",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "test": "node --test tests/build-script.spec.mjs && tsx --test tests/*.spec.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm pack:check",
    "verify:manual": "pnpm build && node ./scripts/e2e/manual-paperclip-verify.mjs"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "^2026.416.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.0",
    "jsdom": "^30.0.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
